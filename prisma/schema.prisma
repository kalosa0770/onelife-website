// OneLife CMS data model.
//
// Two generic tables (`Singleton` and `Item`) hold almost all site content.
// The shape of the `data` JSON for each collection/singleton key is defined
// in `lib/content/registry.ts`, not here — see that file for the field list
// behind every admin form. This keeps adding a new editable section a
// code-only change (one registry entry) instead of a database migration.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// One row per page-level block of content that only ever has a single
/// instance: the hero headline, site-wide contact details, the Mission &
/// Vision copy, etc. `key` is a stable id from the registry (e.g. "hero",
/// "site-settings").
model Singleton {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// One row per entry in a repeatable, admin-manageable list: staff members,
/// platforms, capability cards, track-record stats, milestones, case
/// studies, ventures, etc. `collection` is the registry id for the list
/// (e.g. "staff", "platforms"); `order` controls display order within it.
model Item {
  id         String   @id @default(cuid())
  collection String
  data       Json
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection, order])
}

/// Public form submissions (SWS register-interest / partner enquiry, IMPEX
/// delegate registration / partner enquiry). `form` is an id from
/// `lib/forms/definitions.ts`; `data` holds the validated answers plus
/// attribution (UTMs, referrer) under `_meta`.
model FormSubmission {
  id        String   @id @default(cuid())
  form      String
  data      Json
  createdAt DateTime @default(now())

  @@index([form, createdAt])
}
